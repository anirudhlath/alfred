# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/

# Environment
.env

# IDE
.vscode/
.idea/

# Obsidian vault config (research data itself is tracked)
research/.obsidian/

# Superpowers brainstorm sessions
.superpowers/

# Runtime data & personal information (not source)
core/memory/scratchpad.md
core/memory/triggers/
*.db
*.db-*

# Runtime state (ALFRED_DATA_DIR) — consolidated scratchpad/routines/preferences/secrets/dbs
/data/

# Personal memory files — NOTHING here is tracked. Seeding a shipped preference or
# routine into a real house makes a fixture indistinguishable from something the
# user actually said; core/memory/tests enforce that the package stays empty.
core/memory/preferences/*
core/memory/profile/*
core/memory/routines/*.yaml

# Claude Code local settings
.claude/settings.local.json
.claude/skills
.worktrees/

# Eval run artifacts (generated JSON)
evals/runs/
evals/logs/
core/voice/models/

# Web frontend
web/node_modules/
web/dist/

# Secrets — APNs .p8 signing key and other local credentials (never commit)
secrets/

# Local satellite fleet config — only the .example is tracked
config/satellites.yaml

# Internal planning notes — local-only working files (never commit)
docs/superpowers/plans/2026-07-18-phase0-github-chores.md
docs/superpowers/specs/2026-07-18-reddit-launch-milestone-design.md

# The file backlog is retired: tickets are GitHub issues, sensitive ones private security
# advisories. Any local leftovers (old 🔒 tickets, epic notes) stay out of git.
docs/backlog/
