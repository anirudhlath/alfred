# Alfred configuration — copy to .env and fill in the REQUIRED section.
#   cp .env.example .env  &&  edit  &&  uv run alfredctl doctor
# Everything below "OPTIONAL" has a sane default; leave blank to accept it.
# Host services (Ollama/vLLM/HA) may use localhost — the container rewrites it to the
# host gateway automatically. Secrets are auto-managed (see ALFRED_SECRETS_PASSPHRASE).

# ============================ REQUIRED ============================

# --- System 2 (Conscious Engine) — cloud LLM for reasoning/conversation ---
# OpenRouter key (https://openrouter.ai/keys). Takes precedence over CLAUDE_API_KEY.
OPENROUTER_API_KEY=
# Model string (LiteLLM format). Default routes Claude via OpenRouter.
CLAUDE_MODEL=openrouter/anthropic/claude-sonnet-4

# --- Home Assistant — required only for home control ---
# HA_HOST may be localhost (auto-rewritten in-container).
HA_HOST=http://localhost:8123
# Long-lived token: HA → your profile → Security → Long-lived access tokens.
HA_TOKEN=

# ============================ OPTIONAL ============================

# --- System 1 (Reflex Engine) — fast local inference ---
# Backend: ollama (default) | openai (any OpenAI-compatible server: vLLM, LM Studio)
REFLEX_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
# For REFLEX_BACKEND=openai (vLLM default host http://localhost:8000):
OPENAI_COMPAT_HOST=
OPENAI_COMPAT_MODEL=
# Per-entity window (seconds) for recording events the Reflex Engine sees but
# does not act on. Lower it to capture more; raise it if a flapping device
# floods episodic memory. Minimum is 1 second: anything below is clamped to 1
# (logged), so 0 does NOT disable observation. Unset or unparseable values
# fall back to 300.
OBSERVATION_DEBOUNCE_SECONDS=300

# --- Memory embeddings ---
# Default is ungated and needs no token. Override to a larger model if you like;
# EMBEDDING_DIM auto-tracks known models (set it only for an unknown model).
# A gated model (e.g. google/embeddinggemma-300m) additionally needs HF_TOKEN + license.
EMBEDDING_MODEL=
EMBEDDING_DIM=
HF_TOKEN=

# --- Alternate System 2 key (used only if OPENROUTER_API_KEY is unset) ---
CLAUDE_API_KEY=

# --- Conscious behaviour ---
SESSION_TIMEOUT_MINUTES=30
PROACTIVITY_LEVEL=opinionated
# Max daily spend on cloud LLM APIs (USD)
DAILY_COST_CAP_USD=5.0

# --- Voice (TTS/STT) ---
VOICE_CONFIDENCE_THRESHOLD=0.85
ALFRED_TTS_BACKEND=kokoro           # kokoro | piper
KOKORO_VOICE=am_michael             # catalogue in docs/voice.md
KOKORO_SPEED=1.0
KOKORO_ONNX_PROVIDER=auto           # auto | cpu | cuda | coreml

# --- Signal notifications (optional; needs signal-cli installed) ---
SIGNAL_PHONE_NUMBER=

# --- APNs push (optional — all three required to enable) ---
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=                      # defaults to secrets/AuthKey_<APNS_KEY_ID>.p8

# --- Infrastructure ---
REDIS_HOST=localhost
REDIS_PORT=6379
MQTT_HOST=localhost
MQTT_PORT=1883

# --- Telemetry (SigNoz/OpenTelemetry) ---
SIGNOZ_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Logging ---
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Data & secrets ---
# Data lifecycle: persistent (prod) | ephemeral (dev) | seed (dev + dummy fixtures)
ALFRED_DATA_MODE=persistent
ALFRED_DATA_DIR=./data
# Keyring backend: blank auto-selects (native on macOS, cryptfile in container/Linux).
ALFRED_SECRETS_BACKEND=
# Passphrase for the cryptfile keyring. Leave blank — one is generated and persisted in
# the data dir on first boot. Set it here only to pin your own (and to survive a data
# volume loss). Back up the data dir either way.
ALFRED_SECRETS_PASSPHRASE=
# WebAuthn/admin trust. Loopback + private LAN (RFC1918) + Tailscale are trusted by
# default; add extra CIDRs here (comma-separated). Set ALFRED_TRUSTED_NETWORKS_STRICT=1
# to trust ONLY loopback + Tailscale + the CIDRs you list here.
ALFRED_TRUSTED_NETWORKS=
ALFRED_TRUSTED_NETWORKS_STRICT=
