{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "paths": { "@/*": ["./src/*"] }
  },
  // `src/test/icons.test.ts` reads bytes off disk, so it belongs to the Node
  // project (tsconfig.node.json) instead: `types` here is `vite/client` alone on
  // purpose, and adding `node` would put `process`, `Buffer` and Node's
  // `setTimeout` overloads in front of every browser component in `src`.
  "include": ["src"],
  "exclude": ["src/test/icons.test.ts"]
}
